# Copy to .env and fill in for scheduled scan email alerts

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=your@gmail.com
ALERT_EMAIL_TO=your@gmail.com

# Optional: NVD API key for faster CVE lookups
# NVD_API_KEY=your-nvd-api-key

# Optional: protect public deployment
# SECRET_KEY=random-long-string
# SCANNER_PASSWORD=your-login-password
# SCANNER_API_KEY=your-api-key-for-header-or-login

# Docker: copy this file to .env before docker compose up
